# Required: Groq API key for LLM + Whisper calls
GROQ_API_KEY=your_groq_api_key_here

# Recommended: InsForge Postgres connection string
#   npx @insforge/cli db connection-string
# Leave blank to use a local SQLite file (clairo.db). DATABASE_URL also works.
INSFORGE_DATABASE_URL=

# REQUIRED IN PRODUCTION: signs login tokens. If unset an ephemeral secret is
# generated at startup (every restart then logs everyone out).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# Creates/refreshes the one admin account at startup (audit log, /metrics, demo reseed).
# Self-registration can never create an admin.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-a-long-password

# Optional: header key (X-Admin-Key) for ops scripts hitting /metrics and /analytics/seed.
# ADMIN_API_KEY=

# Optional: Redis for a shared cache + rate-limit counters (in-memory otherwise).
# REDIS_URL=redis://localhost:6379/0

# Optional: extra allowed frontend origins, comma-separated
# (*.vercel.app / *.netlify.app / *.onrender.app / *.railway.app are already allowed)
# CORS_ORIGINS=https://app.example.com

# Optional operational toggles
# GROQ_CHAT_MODEL=openai/gpt-oss-120b   # override the chat model without a deploy
# WORKER_ENABLED=true                   # false when running `python -m app.jobs.worker` separately
# AUTO_MIGRATE=true
# ALLOW_REGISTRATION=true
# LOG_LEVEL=INFO
# LOG_JSON=true
# CHROMA_PATH=chroma_db
