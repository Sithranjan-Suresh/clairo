# Required: Groq API key for LLM + Whisper calls
GROQ_API_KEY=your_groq_api_key_here

# Recommended: InsForge Postgres connection string
# Get it with: npx @insforge/cli db connection-string
# Leave blank to use local SQLite fallback
INSFORGE_DATABASE_URL=

# Optional: path to ChromaDB storage (default: chroma_db)
# CHROMA_PATH=chroma_db

# Optional: comma-separated list of additional allowed CORS origins for
# production frontends, e.g. https://clairo.vercel.app,https://app.clairo.com
# CORS_ORIGINS=
